{
  "name": "vivaldi-tt",
  "version": "1.0.0",
  "description": "Tree-style tab manager for Vivaldi browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "mkdir -p .vitest-tmp && TMPDIR=.vitest-tmp TMP=.vitest-tmp TEMP=.vitest-tmp vitest",
    "test:ui": "mkdir -p .vitest-tmp && TMPDIR=.vitest-tmp TMP=.vitest-tmp TEMP=.vitest-tmp vitest --ui",
    "test:run": "mkdir -p .vitest-tmp && TMPDIR=.vitest-tmp TMP=.vitest-tmp TEMP=.vitest-tmp vitest run",
    "test:e2e": "mkdir -p .playwright-tmp && TMPDIR=.playwright-tmp TMP=.playwright-tmp TEMP=.playwright-tmp playwright test",
    "test:e2e:ui": "mkdir -p .playwright-tmp && TMPDIR=.playwright-tmp TMP=.playwright-tmp TEMP=.playwright-tmp playwright test --ui",
    "test:e2e:debug": "mkdir -p .playwright-tmp && TMPDIR=.playwright-tmp TMP=.playwright-tmp TEMP=.playwright-tmp HEADED=true playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/chrome": "^0.3.7",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
